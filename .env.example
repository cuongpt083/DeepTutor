# ============================================
# DeepTutor (podman compose) — host-side configuration
# ============================================
# Copy to .env and edit. `.env` is gitignored.
#
# All values are loopback bindings on the HOST side. The container-side
# ports come from data/user/settings/system.json (backend_port, frontend_port).
# Edit those + `podman compose restart deeptutor` to change the in-container
# ports. This file is for shifting the host-side mapping only.
#
# The API base URL the browser uses is NOT a compose env var. The
# entrypoint reads `DEEPTUTOR_API_BASE_URL` from
# data/user/settings/system.json on every start (preferring the
# in-network `next_public_api_base`, then the external override
# `next_public_api_base_external`, then `http://localhost:${BACKEND_PORT}`),
# and web/proxy.ts rewrites /api/* and /ws/* to it at request time.
# ============================================

# Host-side loopback bindings (override if 8001/3782/8090 are taken)
HOST_PORT_BACKEND=8001
HOST_PORT_FRONTEND=3782
HOST_PORT_POCKETBASE=8090

# Time zone passed into both backend and frontend.
TZ=UTC

# RAG Knowledge Base pre-seeding:
# When set to false (default), DeepTutor disables automatic pre-retrieval on every turn,
# allowing the agent to call the `rag` tool on-demand only when the query needs knowledge.
# Set to true to re-enable legacy pre-seeding for all turns.
ENABLE_KB_PRESEED=false

# Google Antigravity provider kill switch (default off).
# Set to true (or 1 / yes / on) before configuring Google Antigravity in
# Settings → Providers.
ANTIGRAVITY_ENABLED=false
#
# Docker images do not ship `agy` / `gemini-cli`. Sign in with Google needs
# the Google OAuth *client* (id + secret baked into those CLIs), not a
# `~/.gemini` token cache — do not bind-mount ~/.gemini for this.
# Pick one:
#   1. Set the two values below (from a machine that has agy/gemini-cli),
#   2. Admin UI: Settings → Providers → Configure OAuth Client ID, or
#   3. Mount a Linux `agy` binary at /usr/local/bin/agy, or set ANTIGRAVITY_AGY_PATH.
# ANTIGRAVITY_CLIENT_ID=
# ANTIGRAVITY_CLIENT_SECRET=
# ANTIGRAVITY_AGY_PATH=/usr/local/bin/agy
#
# The borrowed agy/gemini-cli client can ONLY redirect to
# http://localhost:51121/oauth-callback. Do NOT set ANTIGRAVITY_REDIRECT_URI
# unless ANTIGRAVITY_CLIENT_ID/SECRET come from your own Google Cloud OAuth
# client that lists that exact URI — otherwise Google returns
# redirect_uri_mismatch. Behind an HTTPS reverse proxy the localhost tab will
# fail to connect; copy the full address-bar URL and paste it in Settings.
# ANTIGRAVITY_REDIRECT_URI=https://YOUR_DOMAIN/api/settings/providers/google-antigravity/oauth/callback
